# 复制为 .env 并填写。切勿提交真实凭据。

# ---- 注册 ----
REGISTRATION_DRIVER=protocol
CODEX_OAUTH_DRIVER=protocol
ENABLE_CODEX_AUTO=false
ENABLE_2FA=false
REGISTER_PASSWORD=

# ---- 邮箱 ----
USE_EMAIL_SERVICE=false
EMAIL_SOURCE=
REGISTER_EMAIL=
OTP_MAX_WAIT=180
OTP_POLL_INTERVAL=5

# ---- MailCode 域名邮箱 ----
MAILCODE_API_KEY=
MAILCODE_PRODUCT_ID=product_a3783a0ead074b4091631b9ad04153f9
MAILCODE_REQUEST_TIMEOUT=20
MAILCODE_CHANNEL_WAIT_SECONDS=60

# ---- Plus 试用提链 ----
EXTRACT_LINK_API_BASE=
EXTRACT_LINK_CDK=
EXTRACT_LINK_TYPE=pix
EXTRACT_LINK_WORKERS=3
EXTRACT_LINK_QUEUE_LIMIT=500
EXTRACT_LINK_REQUEST_TIMEOUT=30
EXTRACT_LINK_EVENT_TIMEOUT=180

# 免费临时邮箱（无需 Key）
ENABLE_TEMPMAILIO=false
ENABLE_MAILTM=false

# ---- 代理 ----
# JSON 数组或逗号分隔均可
PROXY_POOL=[]
PROTOCOL_PROXY=
PLAN_CHECK_PROXY=
NO_PROXY=false

# ---- 协议浏览器画像 ----
# TLS、UA、Client Hints 与语言均由同一份画像驱动。
PROTOCOL_TLS_PROFILE=chrome_152
# 留空时按代理中的 region-/country- 标识推断。
PROTOCOL_LOCALE=
PROTOCOL_TIMEZONE=

# ---- 浏览器驱动 ----
ROXY_API_BASE=http://127.0.0.1:50100
ROXY_API_TOKEN=
ROXY_WORKSPACE_ID=
ROXY_PROJECT_ID=
ROXY_OPEN_HEADLESS=true
ROXY_DELETE_PROFILE_AFTER_RUN=true

CLOAK_HEADLESS=true
CLOAK_HUMANIZE=true
CLOAK_GEOIP=true
CLOAK_LOCALE=
CLOAK_TIMEZONE=
CLOAK_FINGERPRINT_SEED=

# ---- 省流量 ----
BROWSER_DATA_SAVER_MODE=false
BROWSER_DATA_SAVER_BLOCKED_RESOURCE_TYPES=["image","media"]
BROWSER_DATA_SAVER_BLOCKED_URL_PATTERNS=[]
BROWSER_TRAFFIC_DETAIL_LOG=false
BROWSER_TRAFFIC_DETAIL_MAX_ENTRIES=2000
BROWSER_JS_COVERAGE_LOG=false
BROWSER_JS_COVERAGE_MAX_ENTRIES=1000

# ---- Sentinel ----
# synthetic = 纯 Go 合成（默认，无需 Node）
# sdk_js    = 调用 Node 执行真 sdk.js（需提供 sentinel/sentinel-runner.js）
SENTINEL_SOLVER=synthetic
NODE_BIN=node
SENTINEL_RUNNER_PATH=sentinel/sentinel-runner.js

# ---- WebUI ----
WEBUI_AUTH_CODE=
WEBUI_SESSION_SECRET=
HOST=127.0.0.1
PORT=5000

# ---- 可选能力 ----
PROMO_CHECK_DRIVER=off
